      "segments": [
        {
          "type": "question",
          "html": "<p>¿Qué función cumple Ubuntu Server en esta topología?</p>",
          "id": "funcion-gateway",
          "required": true,
          "questionType": "long-text",
          "options": null,
          "accept": null,
          "label": null
        },
        {
          "type": "question",
          "html": "<p>¿Por qué es necesario NAT y cómo funciona la regla <code>MASQUERADE</code>?</p>",
          "id": "funcion-nat",
          "required": true,
          "questionType": "long-text",
          "options": null,
